{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "华为杯视觉证据计划",
  "type": "object",
  "required": [
    "schema_version",
    "project_title",
    "plan_status",
    "figure_count_lock",
    "visual_encoding_path",
    "color_semantics",
    "problems",
    "global_figures",
    "global_tables",
    "flowcharts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.2"},
    "project_title": {"type": "string", "minLength": 1},
    "plan_status": {"enum": ["draft", "ready"]},
    "figure_count_lock": {
      "type": "object",
      "required": [
        "status",
        "proposed_total",
        "user_requested_total",
        "final_total",
        "counting_rule",
        "confirmation_record"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["proposed", "locked"]},
        "proposed_total": {"type": "integer", "minimum": 0},
        "user_requested_total": {"type": ["integer", "null"], "minimum": 1},
        "final_total": {"type": "integer", "minimum": 0},
        "counting_rule": {"const": "numbered_top_level_figures"},
        "confirmation_record": {"type": "string"}
      }
    },
    "visual_encoding_path": {"type": "string", "minLength": 1},
    "color_semantics": {
      "type": "object",
      "required": ["baseline", "risk_highlight", "improvement", "secondary", "additional_model", "background"],
      "additionalProperties": false,
      "properties": {
        "baseline": {"const": "#2166AC"},
        "risk_highlight": {"const": "#B2182B"},
        "improvement": {"const": "#1B7837"},
        "secondary": {"const": "#F1A340"},
        "additional_model": {"const": "#762A83"},
        "background": {"const": "#999999"}
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/problem"}
    },
    "global_figures": {
      "type": "array",
      "items": {"$ref": "#/$defs/figure"}
    },
    "global_tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/table"}
    },
    "flowcharts": {
      "type": "array",
      "items": {"$ref": "#/$defs/flowchart"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "category",
        "question",
        "applicability",
        "reason",
        "data_shape",
        "representation",
        "result_files",
        "figure_ids",
        "table_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "mechanism_geometry",
            "main_result",
            "independent_validation",
            "error_constraint",
            "comparison_ablation",
            "sensitivity_robustness",
            "scenario",
            "theoretical_boundary",
            "counterexample",
            "complexity_convergence"
          ]
        },
        "question": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["pending", "applicable", "not_needed", "not_possible"]},
        "reason": {"type": "string"},
        "data_shape": {
          "enum": [
            "pending",
            "single_value",
            "ordered_series",
            "multi_point_scan",
            "repeated_trials",
            "distribution",
            "error_structure",
            "matrix_surface",
            "spatial_geometry",
            "graph_flow",
            "analytic_relation"
          ]
        },
        "representation": {"enum": ["pending", "figure", "schematic", "table", "text", "na"]},
        "result_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "figure_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "table_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "panel_id",
        "question",
        "figure_type",
        "figure_family",
        "result_file",
        "fields",
        "units",
        "visual_encoding",
        "asset_directory",
        "asset_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "panel_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
        "question": {"type": "string", "minLength": 1},
        "figure_type": {"type": "string", "minLength": 1},
        "figure_family": {
          "enum": [
            "mechanism",
            "trajectory_spatial",
            "trend_scan",
            "comparison_ranking",
            "prediction_diagnostic",
            "classification_clustering",
            "optimization_decision",
            "distribution_uncertainty",
            "relationship_correlation",
            "heatmap_surface",
            "flow_structure"
          ]
        },
        "result_file": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "units": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "visual_encoding": {"type": "string", "minLength": 1},
        "asset_directory": {"type": "string", "minLength": 1},
        "asset_mode": {"enum": ["native_run", "visual_adapt", "cross_type_inherit"]}
      }
    },
    "paper_link": {
      "type": "object",
      "required": ["chapter", "label", "caption", "reference_context"],
      "additionalProperties": false,
      "properties": {
        "chapter": {"type": "string"},
        "label": {"type": "string", "pattern": "^fig:"},
        "caption": {"type": "string"},
        "reference_context": {"type": "string"}
      }
    },
    "table_paper_link": {
      "type": "object",
      "required": ["chapter", "label", "caption", "reference_context"],
      "additionalProperties": false,
      "properties": {
        "chapter": {"type": "string"},
        "label": {"type": "string", "pattern": "^tab:"},
        "caption": {"type": "string"},
        "reference_context": {"type": "string"}
      }
    },
    "figure": {
      "type": "object",
      "required": [
        "figure_id",
        "scope",
        "scientific_question",
        "claim_ids",
        "evidence_ids",
        "archetype",
        "layout",
        "hero_panel",
        "panels",
        "script",
        "outputs",
        "statistics_report",
        "qa_report",
        "paper",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "scientific_question": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "archetype": {"enum": ["quantitative_grid", "schematic_led", "image_plate_quant", "asymmetric_mixed"]},
        "layout": {"type": "string", "minLength": 1},
        "hero_panel": {"type": ["string", "null"]},
        "panels": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/panel"}},
        "script": {"type": "string", "minLength": 1},
        "outputs": {
          "type": "object",
          "required": ["vector", "preview"],
          "additionalProperties": false,
          "properties": {
            "vector": {"type": "string", "pattern": "\\.(pdf|svg)$"},
            "preview": {"type": "string", "pattern": "\\.png$"}
          }
        },
        "statistics_report": {"type": "string", "minLength": 1},
        "qa_report": {"type": "string", "minLength": 1},
        "paper": {"$ref": "#/$defs/paper_link"},
        "status": {"enum": ["planned", "data_ready", "rendered", "qa_pass", "incomplete"]}
      }
    },
    "schematic": {
      "type": "object",
      "required": [
        "schematic_id",
        "kind",
        "scientific_question",
        "source_refs",
        "elements",
        "tex_source",
        "output_pdf",
        "preview_png",
        "paper",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "schematic_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["mechanism_geometry", "coordinate_transform", "propagation_path", "sampling_folding", "physical_principle"]},
        "scientific_question": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "tex_source": {"type": "string", "pattern": "\\.tex$"},
        "output_pdf": {"type": "string", "pattern": "\\.pdf$"},
        "preview_png": {"type": "string", "pattern": "\\.png$"},
        "paper": {"$ref": "#/$defs/paper_link"},
        "status": {"enum": ["planned", "rendered", "qa_pass", "incomplete"]}
      }
    },
    "table": {
      "type": "object",
      "required": [
        "table_id",
        "scope",
        "question",
        "claim_ids",
        "evidence_ids",
        "table_family",
        "result_files",
        "columns",
        "paper",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "table_family": {
          "enum": [
            "data_quality",
            "variable_definition",
            "parameter_setting",
            "baseline_comparison",
            "main_result",
            "error_budget",
            "robustness_sensitivity",
            "scenario_decision",
            "runtime_complexity",
            "reproducibility"
          ]
        },
        "result_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "columns": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "paper": {"$ref": "#/$defs/table_paper_link"},
        "status": {"enum": ["planned", "data_ready", "qa_pass", "incomplete"]}
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "problem_id",
        "complexity",
        "claims",
        "evidence_matrix",
        "figures",
        "tables",
        "schematics",
        "low_figure_exception",
        "low_table_exception"
      ],
      "additionalProperties": false,
      "properties": {
        "problem_id": {"type": "string", "minLength": 1},
        "complexity": {"enum": ["simple", "standard", "complex"]},
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim_id", "text"],
            "additionalProperties": false,
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_matrix": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/evidence"}},
        "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
        "schematics": {"type": "array", "items": {"$ref": "#/$defs/schematic"}},
        "low_figure_exception": {"type": ["string", "null"]},
        "low_table_exception": {"type": ["string", "null"]}
      }
    },
    "flowchart": {
      "type": "object",
      "required": ["scope", "needed", "reason", "plan_id", "status"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "needed": {"enum": ["pending", "yes", "no"]},
        "reason": {"type": "string"},
        "plan_id": {"type": ["string", "null"]},
        "status": {"enum": ["pending", "planned", "qa_pass", "not_applicable", "incomplete"]}
      }
    }
  }
}
