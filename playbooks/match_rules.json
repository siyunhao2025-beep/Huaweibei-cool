    {"rule_id": "R07", "keywords": ["路径", "网络", "图", "空间分布", "GIS", "选址布局", "节点", "边", "空间插值", "轨迹", "最短路", "航迹", "空间自相关"], "archetype": "spatial-graph", "confidence": 0.75, "evidence_papers": 55, "note": "地理/图结构/空间插值/航迹最短路问题"},
    {"rule_id": "R08", "keywords": ["仿真", "模拟", "蒙特卡洛", "排队", "随机", "多智能体", "随机事件", "演化模拟", "博弈推演", "栅格", "器件仿真", "器件级仿真"], "archetype": "simulation", "confidence": 0.78, "evidence_papers": 40, "note": "随机抽样/数值/器件/多智能体博弈仿真为核心建模范式；置信度低于 mechanism，故当题面同时含机理/状态机/微分方程等机理词时，判定为'仿真仅作验证手段'而归 mechanism，不单独触发 simulation"},
    {"rule_id": "R09", "keywords": ["遗传算法", "粒子群", "模拟退火", "启发式", "智能优化"], "archetype": "optimization", "confidence": 0.6, "evidence_papers": 82, "note": "方法名触发→优化原型（弱信号，需结合题面）"},
    {"rule_id": "R10", "keywords": ["LSTM", "ARIMA", "XGBoost", "随机森林", "BP神经", "回归预测"], "archetype": "prediction", "confidence": 0.6, "evidence_papers": 100, "note": "预测方法名触发"},
    {"rule_id": "R11", "keywords": ["TOPSIS", "AHP", "熵权", "模糊综合", "灰色关联", "DEA", "熵值"], "archetype": "evaluation", "confidence": 0.7, "evidence_papers": 60, "note": "评价方法名触发"},
    {"rule_id": "R12", "keywords": ["YOLO", "UNet", "CNN", "特征提取", "边缘检测", "U-Net"], "archetype": "classification-cv", "confidence": 0.65, "evidence_papers": 35, "note": "CV方法名触发"},
    {"rule_id": "R13", "keywords": ["排队论", "泊松过程", "离散事件", "非齐次泊松"], "archetype": "simulation", "confidence": 0.6, "evidence_papers": 20, "note": "排队/点过程/离散事件触发仿真原型（弱信号；Markov 链已移至 R05 mechanism）"}
