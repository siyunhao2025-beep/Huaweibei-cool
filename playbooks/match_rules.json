{
  "_comment": "题面→8原型规则匹配数据，供 scripts/playbook_match.py 使用。关键词匹配题面文本，置信度=该规则命中时指向原型的把握。evidence_papers=支持该规则的论文数（来自简卡题面/方法聚合）。",
  "version": "wave4c",
  "prototypes": ["optimization", "evaluation", "prediction", "classification-cv", "mechanism", "signal", "spatial-graph", "simulation"],
  "rules": [
    {"rule_id": "R01", "keywords": ["排样", "排布", "调度", "分配", "选址", "车辆路径", "VRP", "最优", "优化", "成本最低", "资源分配"], "archetype": "optimization", "confidence": 0.85, "evidence_papers": 120, "note": "题面出现'最优/分配/调度/排样/路径'且问求极值"},
    {"rule_id": "R02", "keywords": ["评价", "评估", "排序", "打分", "综合评价", "指标体系", "优选", "方案比较", "评审", "权重", "多指标", "去偏", "德尔菲"], "archetype": "evaluation", "confidence": 0.8, "evidence_papers": 70, "note": "多指标打分/排序/选优/评审方案比较；问的是'评好不好'而非'求最优值'"},
    {"rule_id": "R03", "keywords": ["预测", "预报", "外推", "未来", "趋势", "时序", "销量", "需求预测", "临近预报"], "archetype": "prediction", "confidence": 0.85, "evidence_papers": 90, "note": "问未来/未知量外推（时序预测；不含物理反演/反演量估计）"},
    {"rule_id": "R04", "keywords": ["分类", "识别", "聚类", "分割", "检测", "故障诊断", "图像", "模式识别", "目标检测", "跟踪"], "archetype": "classification-cv", "confidence": 0.85, "evidence_papers": 80, "note": "分类/识别/分割/检测/跟踪"},
    {"rule_id": "R05", "keywords": ["微分方程", "动力学", "机理", "传染病", "种群", "稳定性", "分岔", "物理模型", "演化方程", "马尔可夫链", "Markov", "马尔可夫", "通信协议", "信道", "状态转移", "状态机", "神经元", "物理机理", "状态空间"], "archetype": "mechanism", "confidence": 0.85, "evidence_papers": 50, "note": "第一性原理/随机状态机机理建模（Markov 链、通信协议、信道、状态转移、微分方程、物理机理）；'用仿真做验证'不单独归 simulation"},
