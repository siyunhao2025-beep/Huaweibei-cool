{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huaweibei-cool/assets/roadmap/roadmap.schema.json",
  "title": "Huawei Cup Technical Roadmap Spec",
  "description": "技术路线图语义草图 YAML 规格。六层主链路：输入→预处理→模型→求解→验证→输出；反馈控制边仅在真实存在时声明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "layers", "nodes", "edges", "subquestion_mapping"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "year", "track", "version"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "description": "路线图标题，如‘XX问题技术路线图’"},
        "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "track": {"type": "string", "description": "赛道/题号，如 2024A / 2025E"},
        "version": {"type": "string", "description": "语义化版本，如 0.1.0"},
        "feedback_expected": {"type": "boolean", "description": "是否存在由验证/校准/选择返回上游模块的真实控制边；独立测试不得反馈"}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "description": "逻辑分层。推荐六层：input/preprocess/model/solve/validate/output",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "order"],
        "properties": {
          "id": {"type": "string", "enum": ["input", "preprocess", "model", "solve", "validate", "output"], "description": "层 id，渲染器按 order 分列"},
          "label": {"type": "string", "minLength": 1, "description": "层中文名，如 数据输入层"},
          "order": {"type": "integer", "minimum": 0, "description": "层从左到右的排列序号"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "label", "method"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_]+$", "description": "节点唯一 id，如 n_data"},
          "layer": {"type": "string", "enum": ["input", "preprocess", "model", "solve", "validate", "output"]},
          "label": {"type": "string", "minLength": 1, "description": "节点中文标签（图上主显示）"},
          "label_en": {"type": "string", "description": "英文标签，系统无 CJK 字体时优雅回退显示"},
          "method": {"type": "string", "minLength": 1, "description": "方法名，如 NSGA-II / SVM / ODE-RK4；不允许空"},
          "subquestion_ref": {"type": "string", "description": "对应小问编号，如 Q1"},
          "constraint_ref": {"type": "string", "description": "回链读题审计约束编号，如 C1/C2"},
          "chapter_ref": {"type": "string", "description": "回链正文章节号，如 §4.2"},
          "color": {"type": "string", "description": "节点填充色（hex）；缺省按 layer 取语义色板。须为色盲友好色板内"}
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "节点间有向边。type=solid 为数据/计算/评价主链路，type=dashed 仅表示有证据支持的反馈或控制关系",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": {"type": "string", "description": "起点节点 id"},
          "to": {"type": "string", "description": "终点节点 id"},
          "type": {"type": "string", "enum": ["solid", "dashed"]},
          "label": {"type": "string", "description": "边标注，如 迭代/调参/换模型"}
        }
      }
    },
    "subquestion_mapping": {
      "type": "object",
      "minProperties": 1,
      "description": "小问编号 → 节点 id 列表。每个小问至少映射一个节点",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    }
  }
}
