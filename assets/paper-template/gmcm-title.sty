\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gmcm-title}[2026/09/21 Huawei Cup contest title style]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{gmcm-title}
    {This package requires XeLaTeX}
    {Please compile the document with XeLaTeX.}
\fi

\RequirePackage{fontspec}
\RequirePackage{xeCJK}

% The official Word template uses STXinwei (华文新魏) for the three contest
% title lines.  Overleaf normally does not ship that Windows font, so use a
% bundled CJK fallback only for those lines; body text remains controlled by
% gmcmthesis.cls.
\IfFontExistsTF{STXinwei}{%
  \setCJKfamilyfont{hwxw}[AutoFakeBold=2]{STXinwei}%
}{%
  % Use the TeX-tree filename rather than the font-family name.  Minimal Linux
  % runners do not necessarily expose TeX Live's Fandol fonts through
  % fontconfig, while XeTeX can resolve the bundled OTF via kpathsea.
  \IfFontExistsTF{FandolKai-Regular.otf}{%
    \setCJKfamilyfont{hwxw}[AutoFakeBold=2]{FandolKai-Regular.otf}%
  }{%
    \setCJKfamilyfont{hwxw}[AutoFakeBold=2]{FandolSong-Regular.otf}%
  }%
  \PackageWarningNoLine{gmcm-title}{STXinwei not found; using a bundled CJK fallback for contest-title lines}%
}

% #1 = Chinese edition number, for example 二十三.
% The sizes match the 2026 official Word template:
% first line 小二 (18 pt); second and third lines 二号 (22 pt).
\newcommand{\GMCMContestTitle}[1]{%
  \begin{center}
    {\CJKfamily{hwxw}\bfseries\zihao{-2}中国研究生创新实践系列大赛\par}%
    \vspace{1pt}%
    {\CJKfamily{hwxw}\bfseries\zihao{2}“华为杯”第#1届中国研究生\par}%
    \vspace{1pt}%
    {\CJKfamily{hwxw}\bfseries\zihao{2}数学建模竞赛\par}%
  \end{center}%
}
