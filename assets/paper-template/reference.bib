% Basic BibTeX template for a Huawei Cup paper.
% Replace every example below with a real, checked reference before citing it.
% Keep citation keys stable after they are used in TeX.

% Journal article:
% @article{AuthorYearJournal,
%   author  = {Family, Given and Other, Author},
%   title   = {Full article title},
%   journal = {Journal Name},
%   year    = {2024},
%   volume  = {12},
%   number  = {3},
%   pages   = {100--115},
%   doi     = {10.0000/example-doi}
% }

% Conference paper:
% @inproceedings{AuthorYearConference,
%   author    = {Family, Given and Other, Author},
%   title     = {Full conference paper title},
%   booktitle = {Proceedings of the Conference Name},
%   year      = {2024},
%   pages     = {1--10},
%   publisher = {Publisher Name}
% }

% Book:
% @book{AuthorYearBook,
%   author    = {Family, Given},
%   title     = {Book Title},
%   publisher = {Publisher Name},
%   address   = {City},
%   year      = {2024},
%   edition   = {2}
% }

% Technical report or standard:
% @techreport{OrganizationYearReport,
%   author      = {{Organization Name}},
%   title       = {Report or Standard Title},
%   institution = {Institution Name},
%   year        = {2024},
%   number      = {Report-001}
% }

% Web resource:
% @misc{OrganizationYearWeb,
%   author       = {{Organization Name}},
%   title        = {Web page title},
%   year         = {2024},
%   howpublished = {\url{https://example.org/resource}},
%   note         = {Accessed: 2024-01-01}
% }
